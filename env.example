# Frontend / GitHub Pages (network is fixed in src/config.js to Bohr Testnet, Chain ID 968)
VITE_CONTRACT_ADDRESS=
# Required for real WalletConnect QR/mobile pairing on the deployed site.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_PUBLIC_APP_URL=

# Hardhat deployment (optional; Remix + MetaMask is preferred for manual testnet deploy)
DEPLOYER_PRIVATE_KEY=
# Set only for Hardhat deploy, e.g. https://<user>.github.io/<bot-repo>/metadata/
NFT_METADATA_BASE_URI=

# Never commit .env, private keys, seed phrases, or recovery phrases.
